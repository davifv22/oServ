generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String         @id @default(uuid())
  name          String
  email         String
  subdomain     String         @unique
  createdAt     DateTime       @default(now())
  users         User[]
  customers     Customer[]
  employees     Employee[]
  services      Service[]
  serviceOrders ServiceOrder[]
}

model User {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  email      String   @unique
  password   String
  role       Role
  createdAt  DateTime @default(now())
}

model Customer {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  document   String?
  email      String?
  phone      String?
  orders     ServiceOrder[]
  createdAt  DateTime @default(now())
}

model Employee {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  email         String?
  phone         String?
  position      String?
  hasAccess     Boolean  @default(false)
  userId        String?
  createdAt     DateTime @default(now())
}

model Service {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  price      Float
  createdAt  DateTime @default(now())
}

model ServiceOrder {
  id          String             @id @default(uuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id])
  customerId  String?
  customer    Customer?          @relation(fields: [customerId], references: [id])
  title       String
  description String?
  status      ServiceOrderStatus @default(OPEN)
  priority    Priority           @default(MEDIUM)
  total       Float              @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  FINISHED
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
