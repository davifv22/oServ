generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id            String         @id @default(uuid())
  name          String
  tradeName     String?
  document      String?
  email         String
  phone         String?
  address       String?
  city          String?
  state         String?
  zipCode       String?
  subdomain     String         @unique
  createdAt     DateTime       @default(now())
  users         User[]
  customers     Customer[]
  employees     Employee[]
  services      Service[]
  serviceOrders ServiceOrder[]
}

model User {
  id               String                 @id @default(uuid())
  companyId        String
  company          Company                @relation(fields: [companyId], references: [id])
  name             String
  email            String                 @unique
  password         String
  role             Role
  comments         ServiceOrderComment[]  @relation("CommentAuthor")
  auditLogs        ServiceOrderAuditLog[] @relation("AuditActor")
  mentionedIn      CommentMention[]
  notifications    Notification[]
  createdAt        DateTime               @default(now())
}

model Customer {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  document   String?
  email      String?
  phone      String?
  orders     ServiceOrder[]
  createdAt  DateTime @default(now())
}

model Employee {
  id             String         @id @default(uuid())
  companyId      String
  company        Company        @relation(fields: [companyId], references: [id])
  name           String
  email          String?
  phone          String?
  position       String?
  hasAccess      Boolean        @default(false)
  userId         String?
  assignedOrders ServiceOrder[]
  createdAt      DateTime       @default(now())
}

model Service {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  name       String
  price      Float
  createdAt  DateTime @default(now())
}

model ServiceOrder {
  id                    String                 @id @default(uuid())
  companyId             String
  company               Company                @relation(fields: [companyId], references: [id])
  customerId            String?
  customer              Customer?              @relation(fields: [customerId], references: [id])
  responsibleEmployeeId String?
  responsibleEmployee   Employee?              @relation(fields: [responsibleEmployeeId], references: [id])
  title                 String
  description           String?
  status                ServiceOrderStatus     @default(OPEN)
  priority              Priority               @default(MEDIUM)
  total                 Float                  @default(0)
  comments              ServiceOrderComment[]
  auditLogs             ServiceOrderAuditLog[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model ServiceOrderComment {
  id             String           @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder     @relation(fields: [serviceOrderId], references: [id])
  authorId       String
  author         User             @relation("CommentAuthor", fields: [authorId], references: [id])
  message        String           @db.Text
  mentions       CommentMention[]
  createdAt      DateTime         @default(now())
}

model ServiceOrderAuditLog {
  id             String                 @id @default(uuid())
  serviceOrderId String
  serviceOrder   ServiceOrder           @relation(fields: [serviceOrderId], references: [id])
  actorId        String?
  actor          User?                  @relation("AuditActor", fields: [actorId], references: [id])
  action         ServiceOrderAuditAction
  field          String?
  oldValue       String?
  newValue       String?
  message        String                 @db.Text
  createdAt      DateTime               @default(now())
}

model CommentMention {
  id        String              @id @default(uuid())
  commentId String
  comment   ServiceOrderComment @relation(fields: [commentId], references: [id])
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  createdAt DateTime            @default(now())

  @@unique([commentId, userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  kind      NotificationKind
  title     String
  body      String           @db.Text
  readAt    DateTime?
  createdAt DateTime         @default(now())
}

enum NotificationKind {
  MENTION
  SERVICE_ORDER_UPDATED
  SERVICE_ORDER_ASSIGNED
}

enum ServiceOrderAuditAction {
  CREATED
  STATUS_CHANGED
  UPDATED
  COMMENTED
  ASSIGNED
}

enum Role {
  OWNER
  ADMIN
  EMPLOYEE
}

enum ServiceOrderStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  FINISHED
  CANCELED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
